# Biến môi trường cho amora-audio-worker
# SAO CHÉP file này thành .env và điền giá trị thật
# KHÔNG BAO GIỜ commit file .env lên Git

RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
RABBITMQ_RETRY_INITIAL_SECONDS=2
RABBITMQ_RETRY_MAX_SECONDS=30
RABBITMQ_RETRY_RESET_SECONDS=60

AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=amora-voice-bucket

DOTNET_WEBHOOK_URL=http://localhost:5000/api/webhooks/audio-processed
WEBHOOK_SECRET=replace-with-a-long-random-secret
ALLOWED_AUDIO_HOSTS=amora-voice-bucket.s3.amazonaws.com,cdn.amora.pro.vn
MAX_AUDIO_BYTES=20971520
DOWNLOAD_TIMEOUT_SECONDS=20
CHAT_MESSAGE_MAX_RETRIES=3

# Số luồng xử lý song song (khuyến nghị = số CPU core)
WORKER_CONCURRENCY=2
