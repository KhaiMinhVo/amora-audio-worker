# Biến môi trường cho amora-audio-worker
# SAO CHÉP file này thành .env và điền giá trị thật
# KHÔNG BAO GIỜ commit file .env lên Git

RABBITMQ_URL=amqp://guest:guest@localhost:5672//

AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=amora-voice-bucket

DOTNET_WEBHOOK_URL=http://localhost:5000/api/webhooks/audio-processed
WEBHOOK_SECRET=change-me-webhook-secret

# Số luồng xử lý song song (khuyến nghị = số CPU core)
WORKER_CONCURRENCY=2
